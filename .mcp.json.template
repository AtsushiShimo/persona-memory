{
  "mcpServers": {
    "persona-memory": {
      "command": "{{ROOT}}/.venv/bin/python",
      "args": ["-m", "server.main"],
      "cwd": "{{ROOT}}",
      "env": {
        "PERSONA_MEMORY_DB": "{{ROOT}}/data/{{PERSONA}}.db",
        "OLLAMA_HOST": "http://localhost:11434",
        "PERSONA_EMBED_MODEL": "{{EMBED_MODEL}}",
        "PERSONA_LIGHT_MODEL": "{{LIGHT_MODEL}}",
        "PERSONA_HEAVY_MODEL": "{{HEAVY_MODEL}}",
        "PERSONA_JUDGE_MODEL": "{{LIGHT_MODEL}}"
      }
    }
  }
}
